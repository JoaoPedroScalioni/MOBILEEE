# ==============================================================================
# Configuração do Supabase Online (Marcos de 03/nov e 06/nov)
# Copie este arquivo para .env e preencha com as credenciais do seu projeto Supabase
# ==============================================================================

# URL do seu projeto no Supabase (ex: https://abcdefghijklm.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co

# Chave pública anon (encontrada em Settings -> API -> Project API Keys -> anon public)
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.exemplo-de-chave-anon

# Nome do Bucket S3 de armazenamento de comprovantes (padrão: recibos)
EXPO_PUBLIC_SUPABASE_BUCKET=recibos
